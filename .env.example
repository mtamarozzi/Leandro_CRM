# ============================================================================
# Variáveis de ambiente — CRM Leandro Alonso
# ============================================================================
# Copie este arquivo como .env.local e preencha os valores reais.
# O .env.local é ignorado pelo git (.gitignore) e nunca deve ser commitado.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (obrigatório)
# ----------------------------------------------------------------------------
# Encontre em: Supabase Dashboard > Project Settings > API Keys
# Use o formato LEGADO (aba "Legacy anon, service_role API keys")
#
# - URL: Project URL
# - ANON_KEY: chave marcada como "anon public" (começa com eyJ...)
#
# IMPORTANTE: nunca coloque a service_role key em variáveis VITE_*
# pois tudo com prefixo VITE_ é exposto no bundle do frontend.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ----------------------------------------------------------------------------
# Configurações da aplicação
# ----------------------------------------------------------------------------
VITE_APP_NAME="CRM Leandro Alonso"
VITE_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Gemini (opcional — apenas para scripts/testes locais)
# ----------------------------------------------------------------------------
# Em produção a Dorinda usa a credential do n8n, não esta variável.
# Gere em: https://aistudio.google.com/apikey
# IMPORTANTE: nunca prefixar com VITE_ (vazaria no bundle do frontend)
GEMINI_API_KEY=
